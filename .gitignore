# Environment — never commit secrets
.env
.env.local
.env.*.local
foundry-app.env
*.pem

# Runtime data
*.db
*.db-shm
*.db-wal

# Build output
dist/
*/dist/
web/dist/
packages/*/dist/
*.tsbuildinfo

# Dependencies
node_modules/
*/node_modules/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Temporary
*.tmp
*.temp

# Foundry sandbox tool scratch — bounded() writes large stdout dumps
# here, writeTmp() writes patch payloads here, and they live inside the
# per-session workDir which is a clone of the bare repo. Without this,
# workspacePublish's `git add -A` sweeps them into the agent's commit.
.foundry/

# SQLite backup snapshots
*.db.bak*

# Deploy script's last-deployed SHA (server-local state)
.foundry-deployed-sha

