{
  "name": "foundry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/repository/impl/schema/migrations dist/repository/impl/schema/",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.92",
    "better-sqlite3": "^9.6.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.38.0",
    "express": "^4.21.0",
    "tar": "^7.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/tar": "^6.1.13",
    "drizzle-kit": "^0.29.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
