# Required
DB_PATH=./foundry.db
BLOB_DIR=./foundry.blobs
FOUNDRY_ENCRYPTION_KEY=<run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))">

# Auth — pick one
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MAX_SESSION=true

# Optional
PORT=3000
BLOB_THRESHOLD_MB=50
ENGINE_INTERVAL_MINUTES=10
ESCALATION_TIMEOUT_HOURS=48
MAX_PARALLEL_PROJECTS=1
