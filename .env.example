PORT=3000
FOUNDRY_STATE_PATH=./foundry-local.db

# GitHub OAuth (recommended for the web app)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OWNER_GITHUB_LOGIN=

# Recommended: mint a repository-scoped token for each worker cycle
# GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=

# Or use a token for private local operation
GITHUB_TOKEN=

COOKIE_SECURE=false
SANDBOX_RUNTIME=podman
SANDBOX_IMAGE=foundry-worker:latest
SANDBOX_TIMEOUT_MS=1200000
OPENAI_API_KEY=
