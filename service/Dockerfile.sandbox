FROM node:20-bookworm-slim

# glibc-based base so binaries that ship with shared linkage (workerd,
# wrangler's native bits, future ffmpeg/ripgrep/etc.) actually run.
# Alpine + musl was the prior base; it broke wrangler R2 ops because
# workerd dynamically links against glibc and spawn() returned ENOENT.

RUN apt-get update && apt-get install -y --no-install-recommends \
        # core utilities
        coreutils \
        bash \
        # search & file tools
        grep \
        findutils \
        sed \
        gawk \
        # network tools
        curl \
        wget \
        ca-certificates \
        # web scraping
        lynx \
        # version control
        git \
        openssh-client \
        # build tools
        make \
        gcc \
        g++ \
        # python
        python3 \
        python3-pip \
        # common utilities
        jq \
        tar \
        gzip \
        unzip \
        file \
        # headless browser for screenshot / DOM snapshot tools
        chromium \
        fonts-liberation \
        fonts-dejavu-core \
        # PDF -> image / PDF -> text
        poppler-utils \
        # image resize / metadata
        imagemagick \
    && rm -rf /var/lib/apt/lists/*

# Language-family tooling that agents commonly reach for in verification /
# formatting steps. Installed globally so tsc, prettier, eslint, and tsx
# are on PATH without needing a project's local node_modules. Saves the
# `npx tsc --noEmit` install-storm pattern from RCA-001.
RUN npm install -g --silent \
    typescript \
    prettier \
    eslint \
    tsx \
    wrangler \
    puppeteer-core

# Browser tool wrapper. Drives a long-lived headless chromium inside
# the session container via CDP — see reconciler/session/sandbox for
# the lifecycle.
COPY scripts/foundry-browser.mjs /usr/local/bin/foundry-browser
RUN chmod +x /usr/local/bin/foundry-browser

# HOME=/tmp so package managers and dev tools that write to $HOME (npm,
# pip, cargo, etc.) succeed inside the --read-only root filesystem. /tmp
# is tmpfs in the sandbox so it's writable and ephemeral. Without this,
# `npm install` fails on `mkdir: /root/.npm: Read-only file system` and
# agents spiral trying to work around it — the exact pattern that drove
# RCA-001.
ENV HOME=/tmp

WORKDIR /work
