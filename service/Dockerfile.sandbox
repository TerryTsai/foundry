FROM node:20-alpine

RUN apk add --no-cache \
    # core utilities
    coreutils \
    bash \
    # search & file tools
    grep \
    findutils \
    sed \
    gawk \
    # network tools
    curl \
    wget \
    # web scraping
    lynx \
    # version control
    git \
    # build tools
    make \
    gcc \
    g++ \
    musl-dev \
    # python
    python3 \
    py3-pip \
    # common utilities
    jq \
    tar \
    gzip \
    unzip \
    openssh-client

# Language-family tooling that agents commonly reach for in verification /
# formatting steps. Installed globally so tsc, prettier, eslint, and tsx
# are on PATH without needing a project's local node_modules. Saves the
# `npx tsc --noEmit` install-storm pattern from RCA-001.
RUN npm install -g --silent \
    typescript \
    prettier \
    eslint \
    tsx \
    wrangler

# HOME=/tmp so package managers and dev tools that write to $HOME (npm,
# pip, cargo, etc.) succeed inside the --read-only root filesystem. /tmp
# is tmpfs in the sandbox so it's writable and ephemeral. Without this,
# `npm install` fails on `mkdir: /root/.npm: Read-only file system` and
# agents spiral trying to work around it — the exact pattern that drove
# RCA-001.
ENV HOME=/tmp

WORKDIR /work
