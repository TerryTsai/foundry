FROM node:20-bookworm-slim

# glibc-based base so binaries that ship with shared linkage (workerd,
# wrangler's native bits, future ffmpeg/ripgrep/etc.) actually run.
# Alpine + musl was the prior base; it broke wrangler R2 ops because
# workerd dynamically links against glibc and spawn() returned ENOENT.

RUN apt-get update && apt-get install -y --no-install-recommends \
        # core utilities
        coreutils \
        bash \
        # search & file tools
        grep \
        findutils \
        sed \
        gawk \
        # network tools
        curl \
        wget \
        ca-certificates \
        # web scraping
        lynx \
        # version control
        git \
        openssh-client \
        # build tools
        make \
        gcc \
        g++ \
        # python
        python3 \
        python3-pip \
        # common utilities
        jq \
        tar \
        gzip \
        unzip \
        file \
        # headless browser for screenshot / DOM snapshot tools
        chromium \
        fonts-liberation \
        fonts-dejavu-core \
        # PDF -> image / PDF -> text
        poppler-utils \
        # image resize / metadata
        imagemagick \
    && rm -rf /var/lib/apt/lists/*

# Agent tooling that verify/format steps commonly reach for. Installed
# globally so `tsc`, `prettier`, `eslint`, `tsx`, etc. are on PATH
# without a project's local node_modules. The symlink at /node_modules
# lets Node's standard walk-up lookup resolve bare imports like
# `require('playwright-core')` from anywhere in the container — no
# NODE_PATH needed.
RUN PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm install -g --silent \
        typescript \
        prettier \
        eslint \
        tsx \
        wrangler \
        playwright-core \
    && ln -s /usr/local/lib/node_modules /node_modules

# Agent runs in a real user home. The per-session workspace is
# bind-mounted here at runtime, so everything the agent does — clones,
# npm installs, dev servers, tool scratch files — lives under $HOME
# the way Unix expects.
RUN useradd -m foundry
WORKDIR /home/foundry
ENV HOME=/home/foundry
