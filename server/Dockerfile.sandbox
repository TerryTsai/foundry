FROM node:20-bookworm-slim

# glibc-based base so binaries that ship with shared linkage (workerd,
# wrangler's native bits, future ffmpeg/ripgrep/etc.) actually run.
# Alpine + musl was the prior base; it broke wrangler R2 ops because
# workerd dynamically links against glibc and spawn() returned ENOENT.

RUN apt-get update && apt-get install -y --no-install-recommends \
        # core utilities
        coreutils \
        bash \
        # search & file tools
        grep \
        findutils \
        sed \
        gawk \
        # network tools
        curl \
        wget \
        ca-certificates \
        # web scraping
        lynx \
        # version control
        git \
        openssh-client \
        # build tools
        make \
        gcc \
        g++ \
        # python
        python3 \
        python3-pip \
        # common utilities
        jq \
        tar \
        gzip \
        unzip \
        file \
        # headless browser for screenshot / DOM snapshot tools
        chromium \
        fonts-liberation \
        fonts-dejavu-core \
        # PDF -> image / PDF -> text
        poppler-utils \
        # image resize / metadata
        imagemagick \
    && rm -rf /var/lib/apt/lists/*

# CLI tooling agents reach for directly. Globally installed the normal
# way — /usr/local/bin shims land on PATH, same as any dev desktop.
RUN npm install -g --silent \
        typescript \
        prettier \
        eslint \
        tsx \
        wrangler

# websocat: single static Rust binary for speaking WebSocket from the
# shell. The browser tools pipe JSON-RPC CDP messages through it —
# that way every browser tool is a plain curl/jq/websocat/base64
# pipeline, matching the shell-script style of the github tools.
RUN curl -sSL -o /usr/local/bin/websocat \
        https://github.com/vi/websocat/releases/download/v1.13.0/websocat.x86_64-unknown-linux-musl \
    && chmod +x /usr/local/bin/websocat

# Agent runs in a real user home. The per-session workspace is
# bind-mounted here at runtime, so everything the agent does — clones,
# npm installs, dev servers, tool scratch files — lives under $HOME
# the way Unix expects.
RUN useradd -m foundry
WORKDIR /home/foundry
ENV HOME=/home/foundry
